APP_ENV=development
# dev | proxy | oidc  (dev est refusé si APP_ENV=production)
AUTH_MODE=dev
DEV_USER_EMAIL=philippe.zander@example.local
PROXY_USER_HEADER=X-Forwarded-Email
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
SEED_ADMIN_EMAIL=philippe.zander@example.local
SEED_PLANNER_EMAIL=olivier@example.local
WEB_PORT=8080
# Certificat racine du proxy d'entreprise pour le build (optionnel)
EXTRA_CA_FILE=
