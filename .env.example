# Copier en .env (jamais commité, NF-03)
POSTGRES_PASSWORD=change-moi
POSTGRES_USER=planning
POSTGRES_DB=planning
APP_ENV=development
# dev | proxy | oidc  (dev est refusé si APP_ENV=production)
AUTH_MODE=dev
DEV_USER_EMAIL=philippe.zander@example.local
PROXY_USER_HEADER=X-Forwarded-Email
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
SEED_ADMIN_EMAIL=philippe.zander@example.local
SEED_PLANNER_EMAIL=olivier@example.local
WEB_PORT=8080
# Mails : file (dev, fichiers .eml dans le volume « mails ») | smtp (relais interne) | disabled
MAIL_BACKEND=file
MAIL_FROM=philippe.zander@example.local
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Adresse de l'application vue depuis le poste des techniciens (liens J'accepte / Je refuse)
PUBLIC_BASE_URL=http://localhost:8080
# Certificat racine du proxy d'entreprise pour le build (optionnel)
EXTRA_CA_FILE=
